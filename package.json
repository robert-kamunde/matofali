{
  "name": "matofali",
  "version": "1.0.0",
  "private": true,
  "description": "Matofali: a Tanzanian brick-breaker game for Android",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build && npm run test:e2e",
    "cap:sync": "npm run build && cap sync android",
    "assets:android": "node scripts/make-brand-assets.mjs && capacitor-assets generate --android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/preferences": "8.0.1",
    "@fontsource/bungee": "5.2.6",
    "@fontsource/outfit": "5.2.6"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "9.39.0",
    "@playwright/test": "1.63.0",
    "eslint": "9.39.0",
    "globals": "16.4.0",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
